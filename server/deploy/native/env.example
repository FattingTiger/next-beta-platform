# Native staging only. CentOS 7 is end-of-life and must never be used for a
# production deployment. preflight.sh requires this exact acknowledgement.
BETA_ACK_CENTOS7_EOL=I_UNDERSTAND_TEST_ONLY

# Public IPv4 address. The ACME contact is optional and intentionally unused by
# the default Caddyfile, so deployment never invents an email address.
BETA_PUBLIC_IP=__PUBLIC_IPV4__
BETA_ACME_EMAIL=

# Fixed, non-public component addresses. The application derives its HTTPS
# public URL and AllowedHosts list from BETA_PUBLIC_IP at startup.
BETA_DB_HOST=127.0.0.1
BETA_DB_PORT=55432
BETA_DB_NAME=beta_center
BETA_DB_USER=beta_center
BETA_APP_HOST=127.0.0.1
BETA_APP_PORT=18089

# Secret material lives in root-owned files outside the repository. The
# startup wrapper reads them without placing their values in the unit file.
BETA_DB_PASSWORD_FILE=/etc/beta-center-native/secrets/db_password
BETA_APP_SECRET_FILE=/etc/beta-center-native/secrets/app_secret

# If sing-box reads configuration outside /etc/sing-box, list every file or
# directory here, separated by colons. Only SHA-256 fingerprints are retained.
BETA_SING_BOX_CONFIG_PATHS=/etc/sing-box

# Local native tool paths. The staged Android tools artifact must include aapt
# and an apksigner wrapper with its private JRE; no host Java is assumed.
BETA_AAPT_PATH=/opt/beta-center-native/android-tools/bin/aapt
BETA_APKSIGNER_PATH=/opt/beta-center-native/android-tools/bin/apksigner
BETA_JAVA_HOME=/opt/beta-center-native/java
