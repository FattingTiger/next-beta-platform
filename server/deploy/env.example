# The first deployment intentionally binds only to loopback on a high port.
BETA_BIND_ADDRESS=127.0.0.1
BETA_HTTP_PORT=18088
# Choose a /29 that does not overlap any physical, Docker, VPN, or sing-box route.
# deploy/up.sh fails closed when it detects an overlap.
BETA_EDGE_SUBNET=172.31.255.240/29
BETA_EDGE_BRIDGE_GATEWAY=172.31.255.241
BETA_APP_EDGE_IP=172.31.255.242
BETA_GATEWAY_EDGE_IP=172.31.255.243
# The ingress bridge is also explicit and checked for host/VPN route overlap.
# Only Nginx joins it; app and database remain on internal networks.
BETA_INGRESS_SUBNET=172.31.255.248/29
BETA_INGRESS_BRIDGE_GATEWAY=172.31.255.249
BETA_GATEWAY_INGRESS_IP=172.31.255.250
BETA_PUBLIC_BASE_URL=https://beta.example.com
BETA_ALLOWED_HOSTS=["beta.example.com","localhost","127.0.0.1"]
BETA_IMAGE_TAG=local
BETA_VOLUME_PREFIX=beta_center
BETA_DB_NAME=beta_center
BETA_DB_USER=beta_center
BETA_DB_MEM_LIMIT=1g
BETA_DB_CPUS=1.0
BETA_APP_MEM_LIMIT=1536m
BETA_APP_CPUS=1.5
BETA_GATEWAY_MEM_LIMIT=256m
BETA_GATEWAY_CPUS=0.5

# These files must be mode 0600 and must never be committed.
BETA_DB_PASSWORD_FILE=./.secrets/db_password
BETA_APP_SECRET_FILE=./.secrets/app_secret
